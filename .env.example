# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min32chars
JWT_EXPIRY=24h

# Database Configuration (PostgreSQL)
# If empty or connection fails, ConnectUs uses in-memory resilient storage for local testing
DATABASE_URL=postgres://postgres:postgres@localhost:5432/connectus
DB_POOL_MAX=20

# Redis Configuration (Pub/Sub, Presence, Distributed Socket.IO & BullMQ)
# If empty or unreachable, ConnectUs falls back seamlessly to in-memory queues and state
REDIS_URL=redis://localhost:6379

# AI Moderation (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Object Storage / Media Uploads (MinIO / S3)
STORAGE_DRIVER=local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=connectus-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
